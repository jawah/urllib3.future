diff --git a/clickhouse_connect/driver/httputil.py b/clickhouse_connect/driver/httputil.py
--- a/clickhouse_connect/driver/httputil.py
+++ b/clickhouse_connect/driver/httputil.py
@@ -55,11 +55,9 @@
 
 def _close_pool_manager(manager: PoolManager) -> None:
     try:
-        with manager.pools.lock:
-            pools = [manager.pools[key] for key in manager.pools.keys()]
-            manager.clear()
